  "fixed_sql": [
    {
      "name": "habits",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"habits\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL DEFAULT '', \"category\" TEXT NOT NULL, \"color\" TEXT NOT NULL, \"icon\" TEXT NOT NULL, \"schedule_type\" TEXT NOT NULL, \"weekdays\" INTEGER NOT NULL DEFAULT 0 CHECK(\"weekdays\" BETWEEN 0 AND 127), \"times_per_week\" INTEGER NULL CHECK(\"times_per_week\" BETWEEN 1 AND 6), \"daily_target\" INTEGER NOT NULL CHECK(\"daily_target\" BETWEEN 1 AND 20), \"start_date\" INTEGER NOT NULL, \"reminder_time\" TEXT NULL, \"archived_at\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK ((schedule_type = 'onWeekdays') = (weekdays > 0)), CHECK ((schedule_type = 'timesPerWeek') = (times_per_week IS NOT NULL)), CHECK (reminder_time IS NULL OR (reminder_time GLOB '[0-2][0-9]:[0-5][0-9]' AND reminder_time < '24:00')));"
        }
      ]
